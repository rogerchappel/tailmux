Host gpu gpu-admin !gpu-disabled
  HostName gpu-box.tailnet.ts.net
  User roger
  Port 22

Host mini
  HostName mini-lab.tailnet.ts.net
  User roger

Host gpu-ip
  HostName 100.64.0.2
  User roger

hOsT=gpu-equals
  HOSTNAME=gpu-box.tailnet.ts.net
  user=roger
  Port=2222
  IdentityFile="~/.ssh/gpu key"

Host = gpu-spaced
  HostName = gpu-box.tailnet.ts.net
  User = roger
  Port = 65535
  IdentityFile = "~/.ssh/gpu spaced key"

Host quoted
  HostName "quoted#host.tailnet.ts.net" # quoted hashes are data
  IdentityFile "~/.ssh/key #1"

Host *
  ForwardAgent no
